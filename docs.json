{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "PagePith",
  "colors": {
    "primary": "#5B3FD6",
    "light": "#F3C43E",
    "dark": "#4127B7"
  },
  "favicon": "https://pagepith.com/icon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "icon": "house",
          "href": "https://pagepith.com"
        },
        {
          "anchor": "Blog",
          "href": "https://pagepith.com/blog",
          "icon": "newspaper"
        }
      ]
    },
    "groups": [
      {
        "group": "Getting started",
        "icon": "rocket",
        "pages": [
          "index",
          "quickstart",
          "authentication"
        ]
      },
      {
        "group": "Guides",
        "icon": "book-open",
        "pages": [
          "guides/scraping",
          "guides/async-scraping",
          "guides/video",
          "guides/monitoring",
          "guides/mcp"
        ]
      },
      {
        "group": "API reference",
        "icon": "brackets-curly",
        "pages": [
          "api-reference/overview",
          "api-reference/errors",
          {
            "group": "Scrape",
            "icon": "file-code",
            "pages": [
              "api-reference/scrape/scrape-url",
              "api-reference/scrape/scrape-url-async",
              "api-reference/scrape/invalidate-cache"
            ]
          },
          {
            "group": "Monitoring",
            "icon": "radar",
            "pages": [
              "api-reference/monitoring/list-monitors",
              "api-reference/monitoring/create-monitor",
              "api-reference/monitoring/get-monitor",
              "api-reference/monitoring/update-monitor",
              "api-reference/monitoring/run-monitor",
              "api-reference/monitoring/list-checks",
              "api-reference/monitoring/list-events",
              "api-reference/monitoring/delete-monitor"
            ]
          },
          {
            "group": "Video",
            "icon": "video",
            "pages": [
              "api-reference/video/process-video",
              "api-reference/video/get-video-job"
            ]
          },
          {
            "group": "System",
            "icon": "heart-pulse",
            "pages": [
              "api-reference/system/health"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "https://pagepith.com/icon.svg",
    "dark": "https://pagepith.com/icon.svg",
    "href": "https://pagepith.com"
  },
  "navbar": {
    "links": [
      {
        "href": "https://pagepith.com",
        "label": "Website"
      },
      {
        "href": "https://pagepith.com/blog",
        "label": "Blog"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://pagepith.com/dashboard"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "links": [
      {
        "header": "Product",
        "items": [
          {
            "label": "Website",
            "href": "https://pagepith.com"
          },
          {
            "label": "Pricing",
            "href": "https://pagepith.com/"
          },
          {
            "label": "Blog",
            "href": "https://pagepith.com/blog"
          }
        ]
      },
      {
        "header": "Legal",
        "items": [
          {
            "label": "Trust",
            "href": "https://pagepith.com/trust"
          },
          {
            "label": "Privacy",
            "href": "https://pagepith.com/privacy"
          },
          {
            "label": "Terms",
            "href": "https://pagepith.com/terms"
          }
        ]
      }
    ]
  },
  "description": "Documentation for turning web pages, documents, and social videos into clean, structured content with the PagePith API and MCP server.",
  "api": {
    "openapi": "https://api.pagepith.com/openapi.json",
    "params": {
      "expanded": "closed"
    },
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "defaults": "required",
      "languages": [
        "curl",
        "javascript",
        "python"
      ],
      "prefill": true,
      "autogenerate": true
    }
  }
}
